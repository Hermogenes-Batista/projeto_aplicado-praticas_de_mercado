# =============================================================================
# Stage 1: deps — instala apenas dependências de produção
# =============================================================================
FROM node:18-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

# =============================================================================
# Stage 2: builder — compila o Next.js
# =============================================================================
FROM node:18-alpine AS builder

WORKDIR /app

# Recebe a URL da API em tempo de build (NEXT_PUBLIC_* é embutido no bundle)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Garante que o diretório public existe mesmo que o projeto não o tenha criado.
# COPY no stage runner não suporta operadores de shell como || true.
RUN mkdir -p /app/public && npm run build

# =============================================================================
# Stage 3: runner — imagem final mínima usando standalone output
# =============================================================================
FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# next.config.js usa output: 'standalone'
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
