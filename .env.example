# ==============================================================================
# Variáveis de Ambiente - Projeto Aplicado
# ==============================================================================

# --- MySQL Database ---
MYSQL_DATABASE=projeto_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# --- Django Backend ---
DJANGO_PORT=8000
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-secret-key-replace-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# --- Next.js Frontend ---
NEXTJS_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Google OAuth (Opcional - sobrescreve secret.json se definido) ---
CLIENT_ID=
SECRET_KEY=
